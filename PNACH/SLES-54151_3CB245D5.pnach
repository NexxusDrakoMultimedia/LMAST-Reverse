// Backdrops: the season-mode screens draw their Acrobata backdrops (such
// as the scrolling map behind Edit club) from task draw
// methods in the overlays, outside the 2D pass, and the scene reaches past
// the 4:3 area. The task draw loop calls each draw method at 0x1052a8
// (jalr $v1). Send it through a cave instead: if the first 40 words of
// the draw method contain a call to ACROBATA::CAckManager::getInstance
// (jal 0x2e7378, word 0c0b9cde wherever the overlay loads), run it with the
// scissor at 4:3 and with the 2D pass restoring 4:3 rather than full width,
// then put full width back. Other draw methods, the match among them (no
// GAMEPRG code calls getInstance), are passed through untouched.
// Cave in graphics::OperatePostEffect::display_menu (0x13cca8, 0x150
// bytes, a debug menu nothing calls; it and the menus it calls are only
// referenced from the export table):
//   move $t2, $v1; addiu $t3, $zero, 0x28; lui $t1, 0xc0b; ori $t1, $t1, 0x9cde; lw $t0, ($t2); beq $t0, $t1, 0x13ccd4
//   addiu $t3, $t3, -1; bnez $t3, 0x13ccb8; addiu $t2, $t2, 4; jr $v1; nop; addiu $sp, $sp, -0x20
//   sd $ra, ($sp); sd $a0, 8($sp); sd $v1, 0x10($sp); lui $at, 0x14; ld $t0, -0x4038($at); sd $t0, -0x4030($at)
//   jal 0x14cb20; sd $t0, -0x4040($at); ld $v1, 0x10($sp); jalr $v1; ld $a0, 8($sp); lui $at, 0x14
//   ld $t0, -0x32c8($at); sd $t0, -0x4030($at); jal 0x14cb20; sd $t0, -0x4040($at); ld $ra, ($sp); jr $ra
//   addiu $sp, $sp, 0x20
// Data at 0x13cd38: the full-width value.
