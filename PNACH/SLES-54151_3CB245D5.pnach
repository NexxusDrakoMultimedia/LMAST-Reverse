gametitle=Let's Make a Soccer Team! (PAL) [SLES-54151] (3CB245D5)

// Code is patched once, when the executable loads (patch=0): the game never
// reloads it, and rewriting code every frame makes PCSX2 recompile those
// pages each frame. Only the Ninja 2D table words, which the game itself
// writes after boot, are re-applied every frame (patch=1).
//
// Each run of code is one "bytes" line, which writes its hex in memory
// order: every instruction word appears byte-reversed (03e0c82d is
// 2dc8e003). The caves sit in three debug functions nothing calls; unused
// words between the caves are written as zero (nop).

[Widescreen 16:9]
gsaspectratio=16:9
author=LMAST-Reverse
description=Renders the 3D in 16:9 (Hor+) and draws the match HUD, the menus and the season-mode backgrounds at 4:3, centred.

// 3D: nnSetProjectionPXPlusPS2 (0x18f8a8) and nnSetProjection (0x18f450)
// copy the projection matrix to the global one at 0x365ad0 with
// nnCopyMatrix (0x183ec0), then derive the VU screen matrix and clip planes
// from the copy. Both copies are redirected to caves that scale the copy's
// m[0][0] by 0.75 (4:3 -> 16:9, Hor+) for perspective projections
// ($s0 == 0).
//
// The common part only scales while the PX screen half-width (0x369c30) is
// 256, the real screen: graphics::TargetSurface::begin (0x1394a8) puts the
// texture's own screen parameters when the game renders into a texture
// (player portraits, faces), and end (0x139598) restores the screen's.
//
// nnSetProjection is also used by the stadium shadow, so its cave skips the
// two shadow call sites (return addresses 0x13853c and 0x1385c4, read from
// nnSetProjection's frame at 0x60($sp)). Other callers, including ones in
// the overlays (the management screens' staff bodies), are scaled.
patch=0,EE,0018f900,word,0c04be6c
patch=0,EE,0018f488,word,0c04bea4

// The UI fix: the 2D drawn at 4:3 proportions in the middle of the
// 16:9 screen, clipped to the 4:3 area (DOC/WIDESCREEN.md#the-ui-fix).

// Text: Ninja's 2D primitives (nnDrawPrimitive2D 0x1779d8,
// nnuPrimitive2DSetVertex 0x167580, nnDrawPrimitiveSprite2DPS2 0x179cc0)
// map x as offX + x * scaleX from the table at 0x365b98, filled once by
// nnInitSystemPS2 (0x18f318, 0x18f368). The game is 512 wide:
// offX = (2048 - 256) * 16 = 28672, scaleX = 16. Scale by 0.75 about the
// centre: offX = 32768 - 4096 * 0.75 = 29696 (46e80000), scaleX = 12
// (41400000).
patch=1,EE,00365b98,bytes,0000e84600004041

// Panels, scoreboard, clock, radar: CSpriteDirect::SetPrimData (0x126568)
// converts x as ((x - 256) + 2048) * 16 with 256 in $f23. Replace the
// sub.s at 0x12666c with a call to a cave (0x12fa10) that also scales by
// 0.75. The function restores $ra from the stack, so the jal is safe.
patch=0,EE,0012666c,word,0c04be84

// Menus: CSE layouts.
// cseCastFacePutTriStripParamPS2 (0x1f2040) copies each cast node's 3x3
// matrix (rows at $t1; x' = x*m00 + y*m10 + tx) into the VU1 packet in the
// loop at 0x1f20b4. After the loop, 0x1f20e0 jumps to a cave (0x12fa30)
// that scales the copied x column by 0.75 and adds 64 to tx. CSE's own
// matrices are not changed. Only when the CSE screen's offX (context at
// 0x38f458, +0x68) is -0.5, the value etc::InitializeGameSystem sets for
// menus: CEditFaceRender (0x151858) sets its own screen to build custom
// players' face textures.
patch=0,EE,001f20e0,word,0804be8c

// Caves in graphics::Graphics::print_config_parameter (0x12f9b0, 0x170
// bytes), a debug print nothing calls:
// 0x12f9b0, nnSetProjectionPXPlusPS2:
//   move $t9, $ra; jal 0x183ec0; nop ; bnez $s0, 0x12f9cc; nop ; j 0x12fad8
//   nop ; jr $t9; nop
// 0x12fa10, CSpriteDirect:
//   sub.s f12,f12,f23; lui at,0x3f40; mtc1 at,f0; jr ra; mul.s f12,f12,f0
// 0x12fa30, CSE:
//   lui $at, 0x39; lw $at, -0xba8($at); lw $at, 0x68($at); lui $v0, 0xbf00; bne $at, $v0, 0x12fa80
//   nop ; lui $at, 0x3f40; mtc1 $at, $f1; lwc1 $f0, -0x30($t2); mul.s $f0, $f0, $f1
//   swc1 $f0, -0x30($t2); lwc1 $f0, -0x20($t2); mul.s $f0, $f0, $f1; swc1 $f0, -0x20($t2); lwc1 $f0, -0x10($t2)
//   mul.s $f0, $f0, $f1; lui $at, 0x4280; mtc1 $at, $f2; add.s $f0, $f0, $f2; swc1 $f0, -0x10($t2)
//   j 0x1f20e4; lui $v0, 0x6404
// 0x12fa90, nnSetProjection:
//   move $t9, $ra; jal 0x183ec0; nop ; bnez $s0, 0x12fac4; lw $t8, 0x60($sp); lui $at, 0x13
//   ori $t7, $at, 0x853c; beq $t8, $t7, 0x12fac4; ori $t7, $at, 0x85c4; beq $t8, $t7, 0x12fac4; nop ; j 0x12fad8
//   nop ; jr $t9; nop
// 0x12fad8, common: scale m[0][0] at $a0 if the screen half-width is 256;
// return to $t9:
//   lui $at, 0x37; lw $at, -0x63d0($at); lui $t7, 0x4380; bne $at, $t7, 0x12fafc; lui $at, 0x3f40; mtc1 $at, $f1
//   lwc1 $f0, ($a0); mul.s $f0, $f0, $f1; swc1 $f0, ($a0); jr $t9; nop
patch=0,EE,0012f9b0,bytes,

// Margins: UI the game parks just off its 512-pixel screen (the hidden
// squad list, slide-ins) would show in the side margins. Clip the 2D pass
// to the 4:3 area with the GS scissor, like the edge of a 4:3 screen.
// etc::Util_ScissorEnd (0x14cb20) restores a hard-coded full-screen scissor
// (x 0-511, y 0-447) in both draw contexts; make it read that value from a
// variable at 0x13bfc0 instead (0x14cb40-0x14cb4c):
//   lui $at, 0x14; ld $s5, -0x4040($at); nop ; nop
patch=0,EE,0014cb40,bytes,1400013cc0bf35dc0000000000000000
// The 2D pass, sort2d::CSort2d::Execute (0x1fe220), is called from
// sort2d::CEtcSort2d::Execute at 0x14c5d4. Wrap it (cave at 0x13be98): set
// the variable to x 64-447 and apply it, run the pass, then set it back to
// x 0-511 and apply that. Lists that clip themselves during the pass end on
// the 4:3 value.
patch=0,EE,0014c5d4,word,0c04efa6
// etc::Util_ScissorBeginDirect (0x14c860) sets list and ticker clip boxes
// from unsqueezed coordinates, clamped to x 0-511, which would reopen the
// margins. After its clamps, x0 and x1 are floats at 0($sp) and 8($sp);
// map both to x * 0.75 + 64 before they are written to the GS (0x14c9b0
// jumps to the cave at 0x13bee4, which re-runs the moved lui).
patch=0,EE,0014c9b0,word,0804efb9
// sort2d keeps its own scissor pair, used by list and ticker boxes in the
// 2D pass. sort2d::CEtcSort2d::CallScissorEnd (0x14bf28) restores the same
// hard-coded full width; read the variable instead (0x14bf40-0x14bf4c):
//   lui $at, 0x14; ld $v1, -0x4040($at); nop ; nop
patch=0,EE,0014bf40,bytes,1400013cc0bf23dc0000000000000000
// CallScissorBegin (0x14bd70) clamps the box to x 0-511 in unsqueezed
// coordinates; after the clamps, map x0 and x1 (0($sp), 8($sp)) to
// x * 0.75 + 64. 0x14be6c jumps to the cave at 0x13bf1c, which re-runs the
// moved sw.
patch=0,EE,0014be6c,word,0804efc7

// Caves in graphics::GlareFilter::display_reduction_buffer (0x13be98, 0x140
// bytes, a debug display nothing calls):
// 0x13be98, the 2D-pass wrapper:
//   addiu $sp, $sp, -0x10; sd $ra, ($sp); sd $a0, 8($sp); lui $at, 0x14; ld $t0, -0x4038($at)
//   sd $t0, -0x4040($at); jal 0x14cb20; nop ; ld $a0, 8($sp); jal 0x1fe220
//   nop ; lui $at, 0x14; ld $t0, -0x4030($at); sd $t0, -0x4040($at); jal 0x14cb20
//   nop ; ld $ra, ($sp); jr $ra; addiu $sp, $sp, 0x10
// 0x13bee4, Util_ScissorBeginDirect:
//   lui $at, 0x3f40; mtc1 $at, $f1; lui $at, 0x4280; mtc1 $at, $f2; lwc1 $f0, ($sp); mul.s $f0, $f0, $f1
//   add.s $f0, $f0, $f2; swc1 $f0, ($sp); lwc1 $f0, 8($sp); mul.s $f0, $f0, $f1; add.s $f0, $f0, $f2; swc1 $f0, 8($sp)
//   j 0x14c9b4; lui $a2, 0x37
// 0x13bf1c, CallScissorBegin:
//   lui $at, 0x3f40; mtc1 $at, $f1; lui $at, 0x4280; mtc1 $at, $f2; lwc1 $f0, ($sp); mul.s $f0, $f0, $f1
//   add.s $f0, $f0, $f2; swc1 $f0, ($sp); lwc1 $f0, 8($sp); mul.s $f0, $f0, $f1; add.s $f0, $f0, $f2; swc1 $f0, 8($sp)
//   sw $zero, 0x84($t2); j 0x14be70; nop
// 0x13bfc0, data: the variable (starts full width), the 4:3 value, the
// value the wrapper restores (full width).
patch=0,EE,0013be98,bytes,

// Backdrops: the season-mode screens draw their Acrobata backdrops (such
// as the scrolling map behind Edit club) from task draw
// methods in the overlays, outside the 2D pass, and the scene reaches past
// the 4:3 area. The task draw loop calls each draw method at 0x1052a8
// (jalr $v1). Send it through a cave instead: if the first 40 words of
// the draw method contain a call to ACROBATA::CAckManager::getInstance
// (jal 0x2e7378, word 0c0b9cde wherever the overlay loads), run it with the
// scissor at 4:3 and with the 2D pass restoring 4:3 rather than full width,
// then put full width back. Other draw methods, the match among them (no
// GAMEPRG code calls getInstance), are passed through untouched.
patch=0,EE,001052a8,word,0c04f32a
// Cave in graphics::OperatePostEffect::display_menu (0x13cca8, 0x150
// bytes, a debug menu nothing calls; it and the menus it calls are only
// referenced from the export table):
//   move $t2, $v1; addiu $t3, $zero, 0x28; lui $t1, 0xc0b; ori $t1, $t1, 0x9cde; lw $t0, ($t2); beq $t0, $t1, 0x13ccd4
//   addiu $t3, $t3, -1; bnez $t3, 0x13ccb8; addiu $t2, $t2, 4; jr $v1; nop; addiu $sp, $sp, -0x20
//   sd $ra, ($sp); sd $a0, 8($sp); sd $v1, 0x10($sp); lui $at, 0x14; ld $t0, -0x4038($at); sd $t0, -0x4030($at)
//   jal 0x14cb20; sd $t0, -0x4040($at); ld $v1, 0x10($sp); jalr $v1; ld $a0, 8($sp); lui $at, 0x14
//   ld $t0, -0x32c8($at); sd $t0, -0x4030($at); jal 0x14cb20; sd $t0, -0x4040($at); ld $ra, ($sp); jr $ra
//   addiu $sp, $sp, 0x20
// Data at 0x13cd38: the full-width value.
patch=0,EE,0013cca8,bytes,
