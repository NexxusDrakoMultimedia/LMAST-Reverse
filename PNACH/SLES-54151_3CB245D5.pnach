//   add.s $f0, $f0, $f2; swc1 $f0, ($sp); lwc1 $f0, 8($sp); mul.s $f0, $f0, $f1; add.s $f0, $f0, $f2; swc1 $f0, 8($sp)
//   j 0x14c9b4; lui $a2, 0x37
