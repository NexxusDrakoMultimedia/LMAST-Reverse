// Common: scale m[0][0] at $a0 if the screen half-width is 256; return to $t9.
// 0x12fad8:
//   lui $at, 0x37; lw $at, -0x63d0($at); lui $t7, 0x4380; bne $at, $t7, 0x12fafc; lui $at, 0x3f40; mtc1 $at, $f1
//   lwc1 $f0, ($a0); mul.s $f0, $f0, $f1; swc1 $f0, ($a0); jr $t9; nop 
